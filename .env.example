SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
FF_PUBLIC_SITE_URL=https://your-domain.example
FAL_KEY=fal_xxxxxxxxxxxxxxxxxxxx
FF_STORAGE_BUCKET=ff-design-assets
FF_ADMIN_EMAILS=owner@example.com
# Optional: comma-separated Supabase auth user ids for owner/admin accounts.
FF_ADMIN_USER_IDS=
# Optional: server-to-server fallback for /api/admin/credits.
ADMIN_API_KEY=
PORT=3000

# --- iyzico abonelik ödemesi (opsiyonel; bağlanana kadar boş bırakılabilir) ---
# Sandbox: sandbox-merchant.iyzipay.com -> API Anahtarları. CANLI anahtarları repoya/sohbete koyma.
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxxxxxx
# Sandbox: https://sandbox-api.iyzipay.com | Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# "node scripts/iyzico-setup-plans.mjs" çıktısından doldurulur (pricingPlanReferenceCode).
IYZICO_PLAN_GO_REF=
IYZICO_PLAN_PRO_REF=
IYZICO_PLAN_MAX_REF=

# Migration runner (scripts/migrate.mjs) için doğrudan Postgres bağlantısı.
# Supabase Dashboard -> Settings -> Database -> Connection string (URI).
# "npm run migrate" bekleyen migration'ları uygular; service key ile DDL yapılamaz.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- Gözlemlenebilirlik (opsiyonel) ---
# Sentry DSN tanımlanırsa hatalar otomatik Sentry'ye iletilir; boşsa hiçbir şey
# yapılmaz (ek paket gerekmez). DSN aldığınızda yalnızca bu değeri girin.
SENTRY_DSN=
# Sentry ortam etiketi (örn. production / staging). Boşsa VERCEL_ENV/NODE_ENV kullanılır.
SENTRY_ENVIRONMENT=
# Log seviyesi: debug | info | warn | error. Boşsa üretimde "info", aksi halde "debug".
FF_LOG_LEVEL=
